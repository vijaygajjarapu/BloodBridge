PORT=5000
NODE_ENV=development

# Database URL:
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"
# Or for PostgreSQL production:
# DATABASE_URL="postgresql://username:password@localhost:5432/bloodconnect?schema=public"

# JWT Security
JWT_SECRET="your-secure-random-jwt-secret-key-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"
SMTP_FROM_NAME="BloodConnect — Be a Donor. Be a Savior."

# Email OTP Challenge Security
EMAIL_OTP_TTL_SECONDS=300
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# Password Reset Settings
PASSWORD_RESET_TTL_SECONDS=900

# Client Application URL
FRONTEND_URL="http://localhost:5173"

# Family Safety Circle subscription (paid on the website only; no in-app purchase)
SUBSCRIPTION_AMOUNT_INR=200
SUBSCRIPTION_PERIOD_MONTHS=12

# Razorpay payment gateway: create keys at https://dashboard.razorpay.com (use Test Mode keys first: rzp_test_...)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Session: signed-in users are logged out after this many minutes with no clicks or typing
SESSION_IDLE_MINUTES=5

# SMS for "Login with mobile number" (leave empty to send the code to the account's email)
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Emergency alert SMS (needs its own DLT-approved template with variables ##group##, ##place## and ##link##). Empty = in-app alerts only.
MSG91_ALERT_TEMPLATE_ID=

# Phone calls through BloodBridge (masked calls + automatic alert calls for critical requests). Empty = off.
# Exotel: Dashboard -> API settings (SID, API key, API token); CALLER_ID = your ExoPhone.
VOICE_PROVIDER=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.in.exotel.com (Mumbai) or api.exotel.com (Singapore), depending on where your Exotel account is
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=
# Optional, for automatic alert calls: a call flow that reads the alert and asks "press 1 / press 2",
# whose key-press step calls <PUBLIC_API_URL>/api/v1/outreach/voice/keypress?secret=<VOICE_WEBHOOK_SECRET>
EXOTEL_ALERT_FLOW_URL=
VOICE_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:5000

# Optional: automatic yearly renewal charged by Razorpay (create a yearly plan with the same price in Razorpay -> Subscriptions -> Plans)
RAZORPAY_PLAN_ID=
# Optional: secret of the Razorpay webhook pointing to <your-site>/api/v1/subscriptions/webhook (events: subscription.charged, subscription.cancelled, subscription.halted)
RAZORPAY_WEBHOOK_SECRET=
