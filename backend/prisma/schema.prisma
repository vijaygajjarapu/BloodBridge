generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  username        String?   @unique
  fullName        String?
  dateOfBirth     DateTime?
  email           String    @unique
  phone           String?   @unique
  country         String    @default("IN") // ISO 3166-1 alpha-2 code, see shared/countries.ts
  passwordHash    String?
  role            String    @default("donor") // "donor", "admin", "coordinator"
  status          String    @default("active") // "active", "suspended", "pending"
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastActiveAt    DateTime? // last sign-in / session refresh (used to rank donors who are likely to answer)
  language        String    @default("en") // app language: en, hi, te, ta, ml (alerts can use it later)

  donorProfile       DonorProfile?
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdReferrals   Referral[]         @relation("ReferrerUsers")
  receivedReferral   Referral?          @relation("ReferredUser")
  consentRecords     ConsentRecord[]
  notifications      Notification[]     @relation("UserNotifications")
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]         @relation("UserAuditLogs")
  familyMembers      FamilyMember[]     @relation("FamilyOwner")
  familyInvites      FamilyInvite[]     @relation("FamilyInviteOwner")
  pledgesReceived    BloodPledge[]      @relation("PledgeFamilyOwner")
  pledgesGiven       BloodPledge[]      @relation("PledgeDonor")
  subscriptions      Subscription[]
  bloodRequests      BloodRequest[]     @relation("RequestRequester")
  requestResponses   RequestResponse[]  @relation("RequestDonorResponses")
  requestCandidacies RequestCandidate[] @relation("RequestCandidateDonor")
  communityMemberships CommunityMember[]
  donationRecords      DonationRecord[]
  orgMemberships       OrgMember[]
  remoteDonations      RemoteDonation[]
  partnerRedemptions   PartnerRedemption[]
  communitiesCreated   Community[]       @relation("CommunityCreator")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([country])
}

model DonorProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  bloodGroup          String    // A+, A-, B+, B-, AB+, AB-, O+, O-
  country             String    @default("IN") // ISO 3166-1 alpha-2 code
  state               String    // state / province / union territory
  district            String    // district / county
  city                String    // city / town / village
  postalCode          String?   // PIN code in India
  isAvailable         Boolean   @default(true)
  donationWillingness String    @default("regular") // "regular", "emergency_only", "occasional"
  totalDonations      Int       @default(0)
  lastDonationDate    DateTime?
  // Eligibility self-check (see src/modules/eligibility/eligibility.rules.ts)
  sex                 String?   // "male", "female", "other": sets the gap between donations (90 / 120 days)
  weightKg            Int?
  deferredUntil       DateTime? // self-declared reason to wait (tattoo, illness, pregnancy...)
  deferralReason      String?
  permanentlyDeferred Boolean   @default(false)
  // On call: "contact me first" for a set time (ranked higher in smart matching)
  onCallUntil         DateTime?
  // Blood group confirmed by a blood bank report / our team (shown as a "verified" badge, ranked higher)
  bloodGroupVerifiedAt DateTime?
  bloodGroupVerifiedBy String?  // admin user id
  bloodGroupVerifySource String? // e.g. "blood bank card", "lab report", "donation record"
  // How to reach me with emergency alerts (in-app alerts always arrive)
  alertBySms          Boolean   @default(true)
  alertByCall         Boolean   @default(false) // automatic voice call (only when a calling provider is set up)
  quietHoursStart     String?   // "22:00" (India time): no SMS / calls from this time...
  quietHoursEnd       String?   // "07:00" ...until this time
  quietAllowCritical  Boolean   @default(true)  // critical requests may still reach me during quiet hours
  // "Pause my alerts" (travel, exams, unwell, family...): no alerts until this time. Far future = until I turn it back on.
  pausedUntil         DateTime?
  pauseReason         String?   // private, only the donor sees it
  // Last donation date we already sent "You can donate again" for (so it is sent once)
  canDonateAgainNotifiedFor DateTime?
  // Who may reach me: regular (public requests near me) and corporate (colleagues / my company's camps)
  reachRegular        Boolean   @default(true)
  reachCorporate      Boolean   @default(true)
  isProfileCompleted  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bloodGroup])
  @@index([city])
  @@index([country, state, district])
  @@index([country, bloodGroup])
  @@index([isAvailable])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // "google"
  providerSubjectId String   // Google sub ID
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubjectId])
  @@index([userId])
}

model EmailOtpChallenge {
  id           String    @id @default(uuid())
  email        String
  userId       String?
  hashedOtp    String
  purpose      String    // "registration", "login", "password_reset", "contact_verification"
  expiresAt    DateTime
  attemptCount Int       @default(0)
  verifiedAt   DateTime?
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Referral {
  id             String    @id @default(uuid())
  referrerUserId String
  referralCode   String    @unique
  referredUserId String?   @unique
  status         String    @default("active") // "active", "completed", "expired", "revoked"
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  referrer User  @relation("ReferrerUsers", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([referrerUserId])
  @@index([referralCode])
  @@index([status])
}

model ConsentRecord {
  id            String    @id @default(uuid())
  userId        String
  purpose       String    // "contact_sharing", "emergency_broadcast", "sms_alerts", "terms_and_privacy"
  policyVersion String    @default("v2.4-2026")
  isGranted     Boolean
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([policyVersion])
}

model Notification {
  id               String   @id @default(uuid())
  recipientId      String
  notificationType String   // "referral_success", "system", "emergency_request", "security_alert"
  title            String?
  message          String
  payload          String?
  isRead           Boolean  @default(false)
  relatedEntity    String?
  createdAt        DateTime @default(now())

  recipient User @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  category  String   @default("general") // "general", "medical", "technical", "feedback"
  status    String   @default("open") // "open", "in_progress", "resolved", "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model OrganizationSettings {
  id                   String   @id @default("default")
  name                 String   @default("BloodBridge")
  supportHelpline      String   @default("")
  supportEmail         String   @default("support@bloodbridge.org")
  emergencyUrgentLine  String   @default("")
  currentPolicyVersion String   @default("v2.4-2026")
  referralRewardPoints Int      @default(50)
  maintenanceMode      Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Family Safety Circle: a person lists their family members' blood groups,
// invites others, and donors pledge to give a blood group if the family needs it.
// ---------------------------------------------------------------------------

model FamilyMember {
  id          String    @id @default(uuid())
  ownerUserId String
  name        String
  relation    String    // "self", "spouse", "son", "daughter", "father", "mother", "brother", "sister", "other"
  bloodGroup  String    // A+, A-, B+, B-, AB+, AB-, O+, O-
  dateOfBirth DateTime?
  // Optional: this family member (18+) is willing to donate blood. They have no account of their own.
  willingToDonate    Boolean   @default(false)
  useOwnerPhone      Boolean   @default(false) // reach them on the account owner's mobile number
  donorPhone         String?   // their own mobile ("+919876543210") when useOwnerPhone is false
  // Their explicit consent to show their name and mobile number to someone whose blood request they match
  contactConsent     Boolean   @default(false)
  contactConsentAt   DateTime?
  contactConsentText String?   // the exact wording they agreed to
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner User @relation("FamilyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([willingToDonate, bloodGroup])
}

/// A shareable link. Opening it shows only the blood groups needed and the inviter's first name.
model FamilyInvite {
  id          String   @id @default(uuid())
  ownerUserId String
  code        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  owner   User          @relation("FamilyInviteOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  pledges BloodPledge[]

  @@index([ownerUserId])
}

/// A donor's promise to give one blood group to a family in an emergency
model BloodPledge {
  id           String   @id @default(uuid())
  ownerUserId  String   // the family that asked
  donorUserId  String   // the person who pledged
  bloodGroup   String
  inviteId     String?
  shareContact Boolean  @default(true) // permission: the family owner (inviter only) may see my mobile number and call me
  allowRequestAlerts Boolean @default(true) // permission: this family's emergency requests reach me wherever I live
  shareAvailability  Boolean @default(false) // permission: the family owner may see whether I can donate right now
  status       String   @default("active") // "active", "withdrawn" (by donor), "ended" (by family owner), "blocked" (ended + cannot pledge again)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner  User          @relation("PledgeFamilyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  donor  User          @relation("PledgeDonor", fields: [donorUserId], references: [id], onDelete: Cascade)
  invite FamilyInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, donorUserId, bloodGroup])
  @@index([ownerUserId, status])
  @@index([donorUserId])
}

/// Paid plan that unlocks the saved donor list. Bought on the website only (no in-app purchase).
model Subscription {
  id                String    @id @default(uuid())
  userId            String
  plan              String    @default("family_yearly") // family_yearly, unlock_prorated, unlock_anniversary
  amountPaise       Int       // 200 rupees = 20000 paise
  currency          String    @default("INR")
  status            String    @default("created") // "created", "active", "failed"
  provider          String    @default("razorpay") // "razorpay" or "dev_simulated" (local testing only)
  providerOrderId   String?   @unique
  providerPaymentId String?
  providerSubscriptionId String? // Razorpay Subscriptions id when automatic renewal is charged by Razorpay
  autoRenew         Boolean   @default(true) // renews every year until the person turns it off
  // Reserved (refunds were dropped: a person covered by a company keeps their own plan on record, nothing refunded)
  endedReason       String?
  refundPaise       Int?
  refundStatus      String?
  refundId          String?
  cancelledAt       DateTime? // when automatic renewal was turned off
  renewalReminderAt DateTime? // when the "renews soon" reminder was sent
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Emergency blood requests (Blood Nation core)
model BloodRequest {
  id                 String    @id @default(uuid())
  publicCode         String    @unique // short code for the public, information-only share page (/r/CODE)
  requesterUserId    String
  patientName        String    // never shown on the public page or to donors who haven't accepted
  bloodGroup         String
  component          String    @default("whole_blood") // whole_blood, red_cells, platelets, plasma
  unitsNeeded        Int       @default(1)
  unitsFulfilled     Int       @default(0)
  hospitalName       String
  hospitalArea       String?
  hospitalPinCode    String?   // PIN code of the hospital: donors living in it are alerted too
  country            String    @default("IN")
  state              String
  district           String
  city               String
  urgency            String    @default("urgent") // critical, urgent, planned
  neededBy           DateTime?
  notes              String?
  contactPhone       String    // requester's verified mobile: shown to a donor only after they accept
  status             String    @default("submitted") // see BLOOD_REQUEST_STATUSES in requests.service.ts
  verificationStatus String    @default("unverified") // unverified, pending_review, verified, rejected
  verificationNote   String?
  onHold             Boolean   @default(false) // admin hold: paused, no new alerts or responses
  holdReason         String?
  donorsNotified     Int       @default(0)
  waveNumber         Int       @default(0) // how many groups of donors have been contacted
  nextWaveAt         DateTime? // when the next group is contacted if not enough donors accepted (null = no more)
  lastManualWaveAt   DateTime? // requester pressed "Alert more donors now"
  alertCommunityIds  String?   // JSON list of communities near the hospital the requester chose to alert too
  shareNumberInAlerts Boolean  @default(false) // requester chose to show their number in alerts (before a donor accepts)
  alertOrgIds        String?   // JSON list of the requester's organisations whose colleagues are alerted too
  askRemoteReplacement Boolean @default(false) // also ask colleagues in other cities to donate at a partner blood bank (replacement)
  riskScore          Int       @default(0) // automatic fraud checks (0 = no warning signs)
  riskFlags          String?   // JSON list of the warning signs found
  documentStatus     String    @default("none") // none, checking, passed, warnings, failed
  reportCount        Int       @default(0) // donors who reported this request
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  requester User              @relation("RequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  responses  RequestResponse[]
  documents  RequestDocument[]
  reports    RequestReport[]
  candidates RequestCandidate[]

  @@index([status])
  @@index([requesterUserId])
  @@index([country, state, district, bloodGroup])
  @@index([nextWaveAt])
}

/// Ranked donors for a request: who to contact, in which wave, and what happened (private: only counts are shown)
model RequestCandidate {
  id          String    @id @default(uuid())
  requestId   String
  donorUserId String
  score       Int
  rank        Int
  reasons     String    // JSON list of short labels (why this donor ranks here)
  source      String    @default("nearby") // nearby, family, community
  wave        Int?      // which wave contacted them (null = not contacted yet)
  status      String    @default("queued") // queued, alerted, viewed, accepted, declined, withdrawn
  alertedAt   DateTime?
  viewedAt    DateTime?
  respondedAt DateTime?
  quickToken  String?   // secret for the one-tap "I can help" link in SMS / call alerts (random, 144 bits)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor   User         @relation("RequestCandidateDonor", fields: [donorUserId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorUserId])
  @@index([requestId, status])
  @@index([donorUserId])
  @@index([quickToken])
}

model RequestResponse {
  id                String   @id @default(uuid())
  requestId         String
  donorUserId       String
  status            String   @default("accepted") // accepted, declined, withdrawn, donated
  shareDirectNumber Boolean  @default(false) // donor chose to show their own number for THIS request (off by default)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor   User         @relation("RequestDonorResponses", fields: [donorUserId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorUserId])
  @@index([donorUserId])
}

// Hospital directory used to suggest hospital names when posting a request.
// Starts with a small sample list and grows from the hospitals people enter.
model Hospital {
  id        String   @id @default(uuid())
  nameKey   String   // lower-case name used to avoid duplicates
  name      String
  area      String?
  city      String?
  district  String
  state     String
  country   String   @default("IN")
  pinCode   String?
  source    String   @default("user") // "sample" (pre-filled list) or "user" (added from a request)
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, state, district, nameKey])
  @@index([country, state, district])
  @@index([pinCode])
}

// Patient document for a blood request (requisition form / doctor's note), with automatic checks
model RequestDocument {
  id             String   @id @default(uuid())
  requestId      String
  uploaderUserId String
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String   // same file used in another request = flagged
  storagePath    String   // relative to backend/uploads
  ocrText        String?
  checks         String?  // JSON: what was checked and the outcome
  result         String   @default("checking") // checking, passed, warnings, failed
  createdAt      DateTime @default(now())

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([sha256])
}

// A donor reporting a request (money demanded, fake, wrong number...)
model RequestReport {
  id             String   @id @default(uuid())
  requestId      String
  reporterUserId String
  reason         String   // money_demanded, fake_request, wrong_number, other
  details        String?
  createdAt      DateTime @default(now())

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, reporterUserId])
}

/// A community is just a tag donors add to themselves: gated community, villa, apartment, college, company, place of worship, club.
/// Communities never need to sign up (they can be "claimed" by an organiser later). The name is never shown next to a donor: only counts.
model Community {
  id              String   @id @default(uuid())
  name            String
  nameKey         String   // lower-case name without spaces/punctuation, used to stop duplicates
  type            String   @default("other") // gated, villa, apartment, college, company, worship, club, whatsapp, association, other
  inviteCode      String?  // (indexed, unique by generation) shareable link for groups (e.g. a WhatsApp group): /app/communities/join/<code>
  country         String   @default("IN")
  state           String
  district        String
  city            String
  locality        String?
  pinCode         String?
  createdByUserId String?
  claimed         Boolean  @default(false) // an organiser has verified they run it (later)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User?             @relation("CommunityCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members   CommunityMember[]

  @@unique([country, state, district, nameKey])
  @@index([inviteCode])
  @@index([country, state, district])
  @@index([pinCode])
}

/// One person in one community. Private: other users only ever see counts.
model CommunityMember {
  id               String    @id @default(uuid())
  communityId      String
  userId           String
  alertNearby      Boolean   @default(true)  // alert me when a request near this community chooses to alert it
  alertFromMembers Boolean   @default(false) // alert me when a fellow member needs blood, wherever the hospital is
  muted            Boolean   @default(false) // stay listed, but send me nothing from this community
  isAlumni         Boolean   @default(false) // moved away / graduated: no "nearby" alerts
  status           String    @default("active") // active, stale (did not answer "Still at ...?")
  confirmedAt      DateTime  @default(now())
  reconfirmAskedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId, status])
}

/// Phone outreach log: SMS alerts, automatic alert calls and masked calls (numbers stay hidden). Used for limits and support.
model CallAttempt {
  id             String   @id @default(uuid())
  requestId      String
  donorUserId    String
  kind           String   // alert_sms, alert_call, donor_calls_family, family_calls_donor
  provider       String   // msg91, exotel, none
  providerCallId String?
  status         String   // sent, failed, skipped_quiet_hours, not_configured
  createdAt      DateTime @default(now())

  @@index([requestId, donorUserId, kind])
  @@index([createdAt])
}

/// Each donation: confirmed by the donor (needed before it counts as theirs) or recorded by the family who was helped.
model DonationRecord {
  id                 String    @id @default(uuid())
  userId             String
  donatedOn          DateTime
  source             String    // request (family marked it) or self (donor added it)
  requestId          String?
  place              String?
  status             String    @default("confirmed") // pending_donor (family marked it, waiting for the donor), confirmed, rejected (donor said no)
  previousLastDonationDate DateTime? // to undo if the donor says "I did not donate"
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// An organisation (company, college, NGO...) that registers its people. Verified by BloodBridge staff before members can join.
model Organization {
  id           String   @id @default(uuid())
  name         String
  type         String   @default("company") // company, college, ngo, hospital_group, other
  emailDomains String   // JSON list, e.g. ["infosys.com"]: work emails that prove someone belongs here
  inviteCode   String   @unique
  city         String
  state        String
  district     String
  country      String   @default("IN")
  verified     Boolean  @default(false) // contract signed and checked by BloodNation staff; nobody can link before this
  plan         String   @default("pilot") // pilot, paid
  createdById  String?  // the person who asked BloodNation to bring this company on (never made an admin by this)
  // Who to talk to at the company about the contract (from the "Bring BloodNation to your company" request)
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       OrgMember[]
  announcements OrgAnnouncement[]
  eligibility   OrgEligibility[]

  @@index([verified])
}

/// A person's link to an organisation. It sits on their ONE personal account; leaving ends the link, never the account.
model OrgMember {
  id                  String    @id @default(uuid())
  orgId               String
  userId              String
  role                String    @default("member") // member, admin
  workEmail           String
  workEmailVerifiedAt DateTime?
  employeeId          String?
  status              String    @default("pending_email") // pending_email, active, left
  countInImpact       Boolean   @default(true) // count my requests in the company's impact report
  joinedAt            DateTime  @default(now())
  leftAt              DateTime? // last working day (exit date)
  exitSource          String?   // self, org_admin, hr_upload
  // Company-paid Donor Circle: after the exit date it stays free until this date (30-day grace), then the person renews
  coverageEndsAt      DateTime?
  codeHash            String?   // work-email check code (hashed)
  codeExpiresAt       DateTime?
  codeAttempts        Int       @default(0)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId, status])
  @@index([orgId, status])
  @@index([workEmail])
}

/// The company's employee list (eligibility file), uploaded by its HR admin. Only this list lets someone link the
/// company to their personal account: employee ID + date of birth must match a row, or a code is sent to the row's
/// work email. Being removed from the list counts as leaving the company.
model OrgEligibility {
  id           String    @id @default(uuid())
  orgId        String
  employeeId   String    // trimmed and upper-cased, as matched
  dateOfBirth  DateTime  // date only (UTC midnight)
  workEmail    String?   // optional: lets the employee check with a code sent to this work email instead
  status       String    @default("eligible") // eligible, removed
  linkedUserId String?   // the BloodNation account that linked with this row
  linkedAt     DateTime?
  removedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, employeeId])
  @@index([orgId, status])
  @@index([orgId, workEmail])
  @@index([linkedUserId])
}

/// Announcements and donation camps an organisation admin sends to members
model OrgAnnouncement {
  id        String    @id @default(uuid())
  orgId     String
  authorId  String?
  kind      String    @default("announcement") // announcement, camp
  title     String
  body      String
  campDate  DateTime?
  place     String?
  sentTo    Int       @default(0)
  createdAt DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

/// Licensed blood banks that accept "donate here, replace there" donations
model PartnerBloodBank {
  id        String   @id @default(uuid())
  name      String
  licenceNo String?
  address   String?
  city      String
  district  String
  state     String
  country   String   @default("IN")
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  remoteDonations RemoteDonation[]

  @@index([country, state, district, active])
}

/// "Donate here, save a life there": a donor gives at a partner blood bank in their own city as a replacement for a request elsewhere
model RemoteDonation {
  id            String    @id @default(uuid())
  requestId     String
  donorUserId   String
  bloodBankId   String
  status        String    @default("pledged") // pledged, donated (donor says so), confirmed (blood bank / staff confirmed), cancelled
  donationRef   String?   // blood bank slip / donor card number
  pledgedAt     DateTime  @default(now())
  donatedAt     DateTime?
  confirmedAt   DateTime?
  confirmedById String?

  donor    User             @relation(fields: [donorUserId], references: [id], onDelete: Cascade)
  bloodBank PartnerBloodBank @relation(fields: [bloodBankId], references: [id], onDelete: Restrict)

  @@unique([requestId, donorUserId])
  @@index([requestId, status])
}

/// Partner programme: an insurer, term-insurance provider, bank, college or large group sponsors
/// Family Safety Circle for its customers / members. People redeem the programme's code; the partner pays BloodBridge.
model PartnerProgram {
  id           String    @id @default(uuid())
  name         String    // shown to people: "Sponsored by <name>"
  partnerType  String    // insurer, term_insurer, bank, college, employer, group, ngo, other
  code         String    @unique // what customers type, e.g. ACMELIFE-7KQ2
  seats        Int       // how many people can redeem
  monthsFree   Int       @default(12)
  startsAt     DateTime  @default(now())
  endsAt       DateTime? // last day the code can be redeemed
  active       Boolean   @default(true)
  contactName  String?
  contactEmail String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  redemptions PartnerRedemption[]
}

/// One person who redeemed a partner code (one per person per programme)
model PartnerRedemption {
  id             String   @id @default(uuid())
  programId      String
  userId         String
  subscriptionId String?
  redeemedAt     DateTime @default(now())

  program PartnerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([userId])
}
