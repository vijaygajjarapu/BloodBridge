# BloodBridge Frontend Environment Variables
# Switch between "demo" (in-memory mock adapter) and "api" (live backend HTTP adapter)
VITE_APP_MODE=demo

# Base URL for backend REST API endpoints (used when VITE_APP_MODE=api)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Legal entity shown in the footer (Rule 26, Companies (Incorporation) Rules 2014). Leave blank until registered.
VITE_COMPANY_LEGAL_NAME=Manjusha Health Tech Pvt Ltd
VITE_COMPANY_CIN=
VITE_COMPANY_REGISTERED_OFFICE=
VITE_COMPANY_PHONE=
VITE_COMPANY_EMAIL=
VITE_COMPANY_GRIEVANCE_OFFICER=
